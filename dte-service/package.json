{
  "name": "dte-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Microservicio de integración con el sistema DTE de Hacienda El Salvador",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
