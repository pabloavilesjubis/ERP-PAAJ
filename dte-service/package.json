{
  "name": "dte-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Microservicio de integración con el sistema DTE de Hacienda El Salvador",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:migrate":      "node dist/src/db/migrate.js",
    "db:migrate:dev":  "tsx  src/db/migrate.ts",
    "paaj:migrate":      "node dist/src/scripts/migrate-paaj.js",
    "paaj:migrate:dry":  "node dist/src/scripts/migrate-paaj.js --dry-run",
    "paaj:migrate:full": "node dist/src/scripts/migrate-paaj.js --import-dtes",
    "paaj:migrate:dev":  "tsx  src/scripts/migrate-paaj.ts",
    "reset-admin":     "node dist/src/scripts/reset-admin-password.js",
    "reset-admin:dev": "tsx  src/scripts/reset-admin-password.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "^8.3.1",
    "@fastify/static": "^7.0.4",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.5",
    "fastify": "^4.27.0",
    "jsonwebtoken": "^9.0.3",
    "pdfkit": "^0.15.0",
    "pg": "^8.21.0",
    "qrcode": "^1.5.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.12.7",
    "@types/pdfkit": "^0.13.4",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.5",
    "pino-pretty": "^11.0.0",
    "tsx": "^4.10.5",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=20.10.0"
  }
}
