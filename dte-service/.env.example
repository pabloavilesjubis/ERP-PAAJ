NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# ═══════════════════════════════════════════════════════════════════════════
# PIPELINE ERP — config multi-tenant (CERO dependencias externas)
# ═══════════════════════════════════════════════════════════════════════════
# Auth, DB y storage de certs viven en TU VM. No hay Supabase, Auth0, ni
# servicios cloud. Las credenciales MH de cada tenant se cifran en Postgres
# con AES-256-GCM (clave en TENANT_SECRETS_KEY).

# ─── Postgres (en el mismo Docker Compose) ─────────────────────────────────
# Generar password: openssl rand -base64 32 > secrets/postgres_password.txt
POSTGRES_PASSWORD=changeme-genera-uno-fuerte
# DATABASE_URL la arma docker-compose.yml combinando POSTGRES_PASSWORD. Si
# corrés tsx local fuera de docker, expórtala manualmente:
# DATABASE_URL=postgres://pipeline:<PASSWORD>@localhost:5432/pipeline_erp

# ─── JWT secret para auth local ────────────────────────────────────────────
# Generar: openssl rand -base64 48
# Si rotás esto, todos los users tienen que re-loguear.
AUTH_JWT_SECRET=

# ─── Encryption-at-rest para passwords MH de cada tenant ───────────────────
# Generar: openssl rand -base64 32  (32 bytes, AES-256)
# ⚠️ SI LA PERDÉS, todos los tenants quedan ilegibles y hay que re-onboard.
# Guardala en password manager + backup offline.
TENANT_SECRETS_KEY=

# ─── Firmador (sidecar) ────────────────────────────────────────────────────
FIRMADOR_URL=http://firmador:8113

# ─── Storage de archivos generados (PDFs, JSONs, tickets) ──────────────────
STORAGE_DIR=/app/data

# ─── URL pública del API (la usás para construir pdf_url, ticket_url) ──────
PUBLIC_BASE_URL=https://api.pipeline-erp.com

# ─── CORS allowlist (CSV) ──────────────────────────────────────────────────
# Frontend Vercel + dev local. Sin wildcards en producción.
CORS_ALLOWED_ORIGINS=https://app.pipeline-erp.com,http://localhost:5173

# ─── Signup habilitado ─────────────────────────────────────────────────────
# Si lo cerrás (signup_enabled=false), solo se crean tenants vía CLI/admin.
SIGNUP_ENABLED=true

# ─── BEON legacy compat (opcional — solo si seguís corriendo el flujo viejo) ──
BEON_API_KEY=
BEON_ALLOWED_ORIGINS=

# ─── Mailer (opcional) ─────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
