NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# Hacienda (MH) — credenciales del API
MH_ENV=sandbox                       # sandbox | production
MH_NIT=06140000000000                # NIT del contribuyente emisor (14 dígitos, sin guiones)
MH_PASSWORD=                         # clave del API entregada por el MH

# Firmador (sidecar Java) — el cert NO sale de su contenedor
FIRMADOR_URL=http://firmador:8113
FIRMADOR_NIT=06140000000000          # mismo NIT que MH_NIT en operación normal
FIRMADOR_PASSWORD=                   # clave privada del certificado MH

# Datos del emisor (van embebidos en cada DTE)
EMISOR_NRC=
EMISOR_NOMBRE=
EMISOR_COD_ACTIVIDAD=                # CAT-019 (ej. 47711 = comercio al por menor)
EMISOR_DESC_ACTIVIDAD=
EMISOR_NOMBRE_COMERCIAL=
EMISOR_TIPO_ESTABLECIMIENTO=02       # CAT-009: 02=Casa Matriz, 04=Sucursal, 07=Oficina
EMISOR_DEPARTAMENTO=06               # CAT-012 (06=San Salvador)
EMISOR_MUNICIPIO=14                  # CAT-013 (14=San Salvador)
EMISOR_COMPLEMENTO=
EMISOR_TELEFONO=
EMISOR_EMAIL=

# Punto de venta — usados para construir numeroControl
PUNTO_VENTA_ESTABLECIMIENTO=C001     # 4 chars alfanuméricos en mayúscula
PUNTO_VENTA_PUNTO=0001               # 4 chars alfanuméricos en mayúscula
