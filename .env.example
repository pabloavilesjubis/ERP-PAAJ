# Supabase — copia este archivo a .env.local y rellena con tus credenciales
# Hasta que configures esto, la app funciona con localStorage automáticamente.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Activa el adaptador remoto. "local" usa localStorage, "supabase" usa la nube.
VITE_DATA_ADAPTER=local
